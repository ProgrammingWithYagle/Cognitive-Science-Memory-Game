# Optional source-run configuration. Copy to .env and run:
# node --env-file=.env dist/server.cjs
PORT=4173
DATA_DIR=.data
# Set these only for a public HTTPS site behind a trusted proxy:
# PUBLIC_URL=https://your-game.onrender.com
# TRUST_PROXY=1
# Voice is optional. Get these values from your own LiveKit project.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# OpenAI keys are entered transiently in Content Studio, never here.
